 @article{Scherr_Steeger_Sechrest_2026,
 title={Community agreements pedagogy in physics},
 url={http://arxiv.org/abs/2609.34912},
 DOI={10.48550/arXiv.2609.34912},
 abstractNote={The idea of engaging critically and creatively with physics theories is a stretch for many physicists and physics educators. Most physicists become enculturated into the belief that physics definitions, laws, and equations are read from the book of nature. However, this belief obscures how theories are collectively negotiated by people in specific socio-political and personal conditions, and how students’ particular ideas and intuitions will inevitably shape their own practice of science. To help students build their skills for collective theory-building, we suggest a pedagogy for physics in which students actively negotiate the laws and definitions of theories.},
 note={arXiv:2609.34912 [physics.ed-ph]},
 number={arXiv:2609.34912},
 publisher={arXiv},
 author={Scherr, Rachel E. and Steeger, Jer and Sechrest, Paige},
 year={2026}, month=sept }
